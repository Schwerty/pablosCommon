{
  "namespace": "BP_DEBUG_string_length",
  "main": {
    "type": "stack_panel",
    "size": ["100%cm", "100%c"],
    "orientation": "vertical",
    "$text_edit_text_control": "STRING_LENGTH_TEXT",

    "controls": [
      {
        "textbox@common.text_edit_box": {
          "max_length": 99,

          "size": [200, 20]
        }
      },
      {
        "padd@BP_COMMON.panel": {
          "size": ["100%sm", 3]
        }
      },
      {
        "text_wrap@BP_COMMON.panel": {
          "size": ["100%sm", "100%c"],
          "controls": [
            {
              "text": {
                "type": "label",
                "size": ["default", "default"],
                "max_size": ["100%", 100],
                "text": "test",
                "property_bag": {
                  "#p": "CALC_PREFIX:"
                },
                "bindings": [
                  {
                    "source_control_name": "$text_edit_text_control",
                    "binding_type": "view",
                    "source_property_name": "#item_name",
                    "target_property_name": "#in"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#p + #in)",
                    "target_property_name": "#inp"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp - ('%.21s' * #inp)) = '')",
                    "target_property_name": "#d10_1"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp - ('%.31s' * #inp)) = '')",
                    "target_property_name": "#d10_2"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp - ('%.41s' * #inp)) = '')",
                    "target_property_name": "#d10_3"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp - ('%.51s' * #inp)) = '')",
                    "target_property_name": "#d10_4"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp - ('%.61s' * #inp)) = '')",
                    "target_property_name": "#d10_5"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp - ('%.71s' * #inp)) = '')",
                    "target_property_name": "#d10_6"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp - ('%.81s' * #inp)) = '')",
                    "target_property_name": "#d10_7"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp - ('%.91s' * #inp)) = '')",
                    "target_property_name": "#d10_8"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp - ('%.101s' * #inp)) = '')",
                    "target_property_name": "#d10_9"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(90 - (#d10_1 + #d10_2 + #d10_3 + #d10_4 + #d10_5 + #d10_6 + #d10_7 + #d10_8 + #d10_9) * 10)",
                    "target_property_name": "#d10"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#inp - (#p + (('%.' + #d10 + 's') * #in)))",
                    "target_property_name": "#in_d1"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#p + #in_d1)",
                    "target_property_name": "#inp_d1"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp_d1 - ('%.12s' * #inp_d1)) = '')",
                    "target_property_name": "#d1_1"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp_d1 - ('%.13s' * #inp_d1)) = '')",
                    "target_property_name": "#d1_2"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp_d1 - ('%.14s' * #inp_d1)) = '')",
                    "target_property_name": "#d1_3"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp_d1 - ('%.15s' * #inp_d1)) = '')",
                    "target_property_name": "#d1_4"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp_d1 - ('%.16s' * #inp_d1)) = '')",
                    "target_property_name": "#d1_5"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp_d1 - ('%.17s' * #inp_d1)) = '')",
                    "target_property_name": "#d1_6"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp_d1 - ('%.18s' * #inp_d1)) = '')",
                    "target_property_name": "#d1_7"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp_d1 - ('%.19s' * #inp_d1)) = '')",
                    "target_property_name": "#d1_8"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#inp_d1 - ('%.20s' * #inp_d1)) = '')",
                    "target_property_name": "#d1_9"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(9 - (#d1_1 + #d1_2 + #d1_3 + #d1_4 + #d1_5 + #d1_6 + #d1_7 + #d1_8 + #d1_9))",
                    "target_property_name": "#d1"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#d1 + #d10)",
                    "target_property_name": "#length"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
