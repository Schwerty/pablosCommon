{
  "namespace": "BP_DEBUG_slider_textbox",
  "count_t_box@common.text_edit_box": {
    "size": [24, 20],
    "$text_edit_box_content_binding_name": "#count_t_bind",
    "$text_alignment": "center",
    "max_length": 3,
    "$wrap": false,
    "text_type": "NumberChars",
    "$focus_override_up": "FOCUS_OVERRIDE_STOP"
  },
  "count_slider@common.empty_panel": {
    "size": [24, "100%c"],
    "controls": [
      {
        "slider_count@common.slider": {
          "size": [12, 128],
          "$slider_name": "slider_count",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "$slider_direction": "vertical",
          "layer": 99,
          "$slider_value_binding_name": "#content_tier_value",
          "$slider_steps|default": 30,
          "$slider_value|default": 2,
          "property_bag": {
            "#slider_value": "$slider_value",
            "#slider_steps": "$slider_steps"
          },
          "bindings": [
            {
              "binding_name": "#slider_value"
            },
            {
              "binding_name": "#slider_steps"
            }
          ],
          "slider_inverted": true,
          "$slider_box_size": [16, 10],
          "$progress_clip_direction": "down",
          "$slider_progress_color": [1, 0.5, 1]
        }
      }
    ]
  },
  "main": {
    "type": "image",
    "size": [334, 221],
    "texture": "test/book2",
    "controls": [
      {
        "toggle@BP_COMMON.toggle": {
          "$default_texture|default": "test/book_d",
          "$hover_texture|default": "test/book_h",
          "$pressed_hover_texture|default": "test/book_p",
          "sound_name": "bundle.insert",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [69,-2],
          "$pressed_texture|default": "test/book_p",
          "size": [32, 48]
        }
      }
    ]
  }
}
